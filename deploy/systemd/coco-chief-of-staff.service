[Unit]
Description=CoCo Chief of Staff signed GitHub webhook
After=network-online.target coco.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/pcopu/env/coco
ExecStart=/home/pcopu/env/coco/.venv/bin/python -m coco.chief_of_staff serve
Restart=always
RestartSec=5
Environment=HOME=/home/pcopu
Environment=COCO_DIR=/home/pcopu/.coco
Environment=COS_ENV_FILE=/home/pcopu/.coco/chief-of-staff.env
Environment=PYTHONUNBUFFERED=1
Environment="PATH=/home/pcopu/.nvm/versions/node/v24.13.1/bin:/home/pcopu/.local/bin:/usr/local/bin:/usr/bin:/bin"

[Install]
WantedBy=default.target
